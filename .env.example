# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=familyagent
POSTGRES_PASSWORD=change_me_postgres
POSTGRES_DB=familyagent
DIFY_DB=dify

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=change_me_redis

# ── Dify ──────────────────────────────────────────────────────────────────────
# 随机字符串，openssl rand -hex 32
DIFY_SECRET_KEY=change_me_dify_secret
# 在 Dify 控制台 → 知识库 → API Keys 创建
DIFY_API_KEY=change_me_dify_api_key
# 知识库 dataset ID（在 Dify 控制台查）
DIFY_DATASET_ID=change_me_dataset_id

# ── Weaviate ──────────────────────────────────────────────────────────────────
WEAVIATE_API_KEY=change_me_weaviate

# ── 模型 API（DeepSeek 兼容 OpenAI 协议）─────────────────────────────────────
OPENAI_API_BASE=https://api.deepseek.com/v1
# ⚠️ 必填：DeepSeek API key，用于 LLM（对话摘要）
OPENAI_API_KEY=sk-change_me_deepseek_key
# Mem0 用于提取记忆摘要的 LLM
LLM_MODEL=deepseek-chat

# ── Embedding（向量化，独立于 LLM，需单独注册）────────────────────────────────
# 注意：DeepSeek 不提供 embedding，需单独配置 embedding 服务。
# OPENAI_API_KEY（DeepSeek）和 EMBEDDING_API_KEY 是两个不同的 key，不能混用。
#
# 【当前默认：方案B 云端硅基流动，无需本地大镜像，推荐网络受限环境】
# 注册步骤：https://siliconflow.cn → 控制台 → API 密钥 → 新建 → 复制
# ⚠️ 必填：将下方 sk-change_me_siliconflow_key 替换为你的硅基流动 API key
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=sk-change_me_siliconflow_key
EMBEDDING_DIMS=1024
# 填好后在主目录执行：docker compose restart mem0
#
# 【备选：方案A 本地 Xinference（需能拉 xprobe/xinference:latest-cpu，约3.3GB）】
# 网络畅通/有 GPU 时可改用本地托管：
#   EMBEDDING_MODEL=qwen3-embedding
#   EMBEDDING_BASE_URL=http://xinference:9997/v1
#   EMBEDDING_API_KEY=xinference
#   EMBEDDING_DIMS=1536
#   注意：切模型必须同步改 EMBEDDING_DIMS（bge-m3=1024，qwen3-embedding=1536），
#   维度与 pgvector collection 不一致会在写记忆时报错。

# ── Cloudflare Tunnel（外网访问，docker compose --profile tunnel up 时才需要）──
CLOUDFLARE_TUNNEL_TOKEN=change_me_tunnel_token

# ── 企业微信 ──────────────────────────────────────────────────────────────────
WECHAT_CORP_ID=change_me_corp_id
WECHAT_APP_SECRET=change_me_app_secret
WECHAT_AGENT_ID=change_me_agent_id
WECHAT_TOKEN=change_me_token
WECHAT_AES_KEY=change_me_aes_key
