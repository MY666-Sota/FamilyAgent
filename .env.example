# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=familyagent
POSTGRES_PASSWORD=change_me_postgres
POSTGRES_DB=familyagent
DIFY_DB=dify

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=change_me_redis

# ── Dify ──────────────────────────────────────────────────────────────────────
# 随机字符串，openssl rand -hex 32
DIFY_SECRET_KEY=change_me_dify_secret
# 在 Dify 控制台 → 知识库 → API Keys 创建
DIFY_API_KEY=change_me_dify_api_key
# 知识库 dataset ID（在 Dify 控制台查）
DIFY_DATASET_ID=change_me_dataset_id

# ── Weaviate ──────────────────────────────────────────────────────────────────
WEAVIATE_API_KEY=change_me_weaviate

# ── 模型 API（DeepSeek 兼容 OpenAI 协议）─────────────────────────────────────
OPENAI_API_BASE=https://api.deepseek.com/v1
OPENAI_API_KEY=sk-change_me_deepseek_key
# Mem0 用于提取记忆摘要的 LLM
LLM_MODEL=deepseek-chat
# Mem0 用于向量化的 Embedding（Xinference 托管）
EMBEDDING_MODEL=qwen3-embedding
EMBEDDING_BASE_URL=http://xinference:9997/v1

# ── 企业微信 ──────────────────────────────────────────────────────────────────
WECHAT_CORP_ID=change_me_corp_id
WECHAT_APP_SECRET=change_me_app_secret
WECHAT_AGENT_ID=change_me_agent_id
WECHAT_TOKEN=change_me_token
WECHAT_AES_KEY=change_me_aes_key
