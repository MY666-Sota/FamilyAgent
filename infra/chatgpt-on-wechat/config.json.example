{
  "channel_type": "wework",
  "model": "claude",
  "single_chat_prefix": [""],
  "single_chat_reply_prefix": "",
  "group_chat_prefix": ["@bot"],
  "group_name_white_list": ["ALL_GROUP"],

  "wework_corp_id": "${WECHAT_CORP_ID}",
  "wework_app_secret": "${WECHAT_APP_SECRET}",
  "wework_agent_id": "${WECHAT_AGENT_ID}",
  "wework_token": "${WECHAT_TOKEN}",
  "wework_aes_key": "${WECHAT_AES_KEY}",

  "use_linkai": false,

  "plugin_trigger_prefix": "#",
  "plugins": [],

  "custom_bot": {
    "enabled": true,
    "forward_url": "http://host.docker.internal:8081/v1/message",
    "reply_field": "content"
  },

  "expires_in_seconds": 3600,
  "debug": false
}
