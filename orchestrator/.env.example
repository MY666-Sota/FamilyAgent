# ── 运行时环境变量（复制为 .env 并填入真实值）────────────────────────

# LLM（DeepSeek V3，用于意图分类；未设置时降级为关键词分类）
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# 编排服务端口（默认 8081）
ORCHESTRATOR_PORT=8081

# Mem0 记忆服务（窗口2 提供）
MEM0_BASE_URL=http://localhost:8082
USE_REAL_MEM0=false      # true = 对接真实 Mem0

# RAG 知识库（窗口2 提供）
RAG_BASE_URL=http://localhost:5001
USE_REAL_RAG=false       # true = 对接真实 RAG

# 渠道回调（窗口2 提供）
CHANNEL_BASE_URL=http://localhost:8080
USE_REAL_CHANNEL=false   # true = 对接真实渠道回调

# MCP 工具服务（窗口3 提供）
USE_REAL_MCP=false       # true = 对接真实 MCP Servers
